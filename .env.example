# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon or local Postgres), read by
# prisma/schema.prisma. Example shape only — not a real credential.
# Neon connection strings typically need `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign the demo-auth session cookie (lib/session.ts,
# HMAC-SHA256). Required before /login will work. Generate a random local
# value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value here.
SESSION_SECRET=
